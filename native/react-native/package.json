{
  "name": "b4skills-native",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "ios": "react-native run-ios",
    "android": "react-native run-android",
    "lint": "eslint .",
    "lint:ci": "eslint . --max-warnings 166",
    "start": "react-native start",
    "test": "jest",
    "macos": "react-native run-macos",
    "type-check": "tsc --noEmit",
    "live-smoke": "../../node_modules/.bin/tsx scripts/live-smoke.ts",
    "pods": "cd ios && pod install && cd ../macos && pod install",
    "e2e:backend": "bash scripts/e2e/start-local-backend.sh",
    "e2e:real-backend": "node scripts/e2e/start-real-backend.mjs",
    "e2e:real-candidates": "DOTENV_CONFIG_PATH=build/realdb-validation/backend.env node -r dotenv/config scripts/e2e/provision-real-candidates.mjs",
    "e2e:real-smoke": "DOTENV_CONFIG_PATH=build/realdb-validation/backend.env node -r dotenv/config ../../node_modules/tsx/dist/cli.mjs scripts/e2e/real-database-smoke.ts",
    "e2e:code": "../../node_modules/.bin/tsx scripts/e2e/code-smoke.ts",
    "logo": "python3 scripts/prepare-logo.py ../../public/b4skillslogo.png src/assets/b4skills-logo.png",
    "e2e:proctoring": "DOTENV_CONFIG_PATH=build/realdb-validation/backend.env node -r dotenv/config ../../node_modules/tsx/dist/cli.mjs scripts/e2e/proctoring-real-smoke.ts",
    "e2e:build-ipad": "bash scripts/e2e/build-ipad-simulator.sh",
    "e2e:camera": "DOTENV_CONFIG_PATH=build/realdb-validation/backend.env node -r dotenv/config ../../node_modules/tsx/dist/cli.mjs scripts/e2e/camera-real-smoke.ts",
    "e2e:camera-queue": "DOTENV_CONFIG_PATH=build/realdb-validation/backend.env node -r dotenv/config ../../node_modules/tsx/dist/cli.mjs scripts/e2e/camera-queue-real-smoke.ts",
    "test:photo-vault": "bash scripts/tests/photo-vault.sh",
    "e2e:queue-harness": "bash scripts/e2e/build-photo-queue-harness.sh",
    "e2e:verify-native-queue": "DOTENV_CONFIG_PATH=build/realdb-validation/backend.env node -r dotenv/config ../../node_modules/tsx/dist/cli.mjs scripts/e2e/verify-native-photo-queue.ts",
    "release:check": "python3 scripts/release/preflight.py",
    "release:archive": "bash scripts/release/archive.sh",
    "release:export": "bash scripts/release/export.sh",
    "icons": "python3 scripts/prepare-app-icons.py && python3 scripts/prepare-android-icons.py",
    "release:bundle": "bash scripts/release/bundle.sh"
  },
  "dependencies": {
    "b4-native": "file:modules/b4-native",
    "react": "19.2.0",
    "react-native": "0.83.10",
    "react-native-macos": "^0.83.0",
    "react-native-safe-area-context": "^5.5.2",
    "react-native-svg": "^15.16.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.0.0",
    "@react-native-community/cli-platform-android": "20.0.0",
    "@react-native-community/cli-platform-ios": "20.0.0",
    "@react-native/babel-preset": "0.83.10",
    "@react-native/eslint-config": "0.83.10",
    "@react-native/metro-config": "0.83.10",
    "@react-native/typescript-config": "0.83.10",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.0",
    "typescript": "^5.8.3",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=20"
  }
}
