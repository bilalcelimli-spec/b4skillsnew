# ─────────────────────────────────────────────────────────────────────────────
# B4Skills / LinguAdapt — Environment Variables
#
# Copy this file to .env and fill in the values.
#   cp .env.example .env
#
# REQUIRED at startup: DATABASE_URL, JWT_SECRET, REFRESH_SECRET
# Server starts in mock/demo mode if DATABASE_URL is absent.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Application ─────────────────────────────────────────────────────────────
APP_URL="http://localhost:3001"
VITE_APP_URL="http://localhost:3001"
PORT="3001"

# ─── Database (PostgreSQL) ───────────────────────────────────────────────────
# Required for full functionality. Starts in mock mode if unset.
DATABASE_URL="postgresql://user:password@localhost:5432/b4skills"

# Multi-region replicas (optional — omit for single-region deployments)
# DATABASE_URL_EU=""
# DATABASE_URL_APAC=""

# Connection pool (optional defaults shown)
# DB_CONNECTION_LIMIT="10"
# DB_POOL_TIMEOUT="20"

# ─── Auth (JWT) ──────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 64
JWT_SECRET=""
REFRESH_SECRET=""

# Certificate HMAC signing (optional — used for QR-verifiable certificates)
# CERT_HMAC_SECRET=""
# CERT_SIGNING_KEY_PEM=""

# ─── AI / Gemini ─────────────────────────────────────────────────────────────
# Obtain from https://aistudio.google.com/apikey
# NEVER use in client-side code — server-side only.
GEMINI_API_KEY=""

# OpenAI — used for Whisper ASR transcription and GPT-4 ensemble scoring
OPENAI_API_KEY=""

# Anthropic / Claude — used in multi-rater AI scoring ensemble
ANTHROPIC_API_KEY=""

# Ensemble scoring: set to "true" to enable multi-provider rater
USE_ENSEMBLE_SCORING="false"

# ─── Email (Resend) ──────────────────────────────────────────────────────────
# Obtain from https://resend.com/api-keys
# If unset, emails are logged to console only (dev mode)
RESEND_API_KEY=""
EMAIL_FROM="B4Skills <noreply@b4skills.com>"

# ─── Payments (Stripe) ───────────────────────────────────────────────────────
# Obtain from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=""
# Webhook secret — obtain from https://dashboard.stripe.com/webhooks
# Run `stripe listen --forward-to localhost:3001/webhooks/stripe` in dev
STRIPE_WEBHOOK_SECRET=""

# ─── Social SSO ──────────────────────────────────────────────────────────────
# Google OAuth2 — https://console.cloud.google.com/apis/credentials
# Add http://localhost:3001/api/auth/social/google/callback as Authorised redirect URI
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3001/api/auth/social/google/callback"

# Microsoft (Entra ID) — https://portal.azure.com/#view/Microsoft_AAD_RegisteredApps
# Add http://localhost:3001/api/auth/social/microsoft/callback as redirect URI
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_TENANT_ID="common"
MICROSOFT_REDIRECT_URI="http://localhost:3001/api/auth/social/microsoft/callback"

# LinkedIn — https://www.linkedin.com/developers/apps
# Add http://localhost:3001/api/auth/social/linkedin/callback as redirect URI
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
LINKEDIN_REDIRECT_URI="http://localhost:3001/api/auth/social/linkedin/callback"

# ─── Cache / Rate Limiting (Redis) ───────────────────────────────────────────
# Falls back to in-memory store if unset (not suitable for multi-process prod)
REDIS_URL=""
# REDIS_URL_EU=""
# REDIS_URL_APAC=""

# ─── Storage (AWS S3 — audio recordings, proctoring snapshots) ───────────────
# Required for speaking section audio and proctoring face snapshots
AWS_REGION="eu-west-1"
# AWS_SECRET_ARN=""           # Secrets Manager ARN (alternative to inline keys)
IDENTITY_SNAPSHOT_BUCKET=""  # S3 bucket for proctoring face capture
DATA_WAREHOUSE_BUCKET=""     # S3 bucket for data export / analytics pipeline
VIDEO_CDN_BASE=""            # CloudFront or CDN base URL for audio playback

# ─── Observability ───────────────────────────────────────────────────────────
LOG_LEVEL="debug"
SENTRY_DSN=""
# Frontend Sentry DSN (VITE_ prefix makes it available in browser bundle)
VITE_SENTRY_DSN=""
SENTRY_TRACES_SAMPLE_RATE="0.1"
SENTRY_PROFILES_SAMPLE_RATE="0.1"

# OpenTelemetry — set OTLP_ENDPOINT to enable traces + metrics export
# e.g. http://localhost:4318 for a local Grafana Alloy / OTel Collector
# Leave empty to disable OTel (Sentry still captures errors)
OTLP_ENDPOINT=""
OTEL_SERVICE_NAME="linguadapt"

# ─── Psychometric / Engine Tuning (optional — defaults shown) ────────────────
# CALIBRATION_MIN_N="200"           # Minimum responses before calibration
# CALIBRATION_PROMOTE_N="200"       # Responses required to promote CALIBRATION → ACTIVE
# CALIBRATION_PROMOTE_MAX_DELTA_B="0.5"  # Max b-parameter drift allowed at promotion
# AI_SCORE_CONCURRENCY="4"          # Parallel AI scoring requests
# USE_GRM_PRODUCTIVE="false"        # Enable Graded Response Model for productive skills
# USE_RL_SELECTOR="false"           # Enable RL-based item selector (experimental)
# REALTIME_CALIB_MIN_N="50"         # Minimum responses for real-time calibration update
# REALTIME_CALIB_INTERVAL_MS="60000"

# ─── LMS Integrations (optional) ─────────────────────────────────────────────
# Moodle
# MOODLE_BASE_URL=""
# MOODLE_WS_TOKEN=""

# Canvas
# CANVAS_BASE_URL=""
# CANVAS_ACCESS_TOKEN=""

# ─── Security / Audit ────────────────────────────────────────────────────────
# AUDIT_HMAC_SECRET=""              # HMAC key for audit log integrity stamps
# CORS_ORIGINS=""                   # Comma-separated allowed CORS origins (default: APP_URL)
# RESEARCH_PSEUDO_SALT=""           # Salt for pseudonymising research data exports

# ─── Admin Seed ──────────────────────────────────────────────────────────────
# If set, an admin user is upserted on every startup.
# Leave unset to skip seeding (recommended in production after first deploy).
ADMIN_SEED_EMAIL="admin@example.com"
ADMIN_SEED_PASSWORD="ChangeMe@SecurePassword123"
