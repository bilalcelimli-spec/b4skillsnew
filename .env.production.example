# Production Environment Variables
# Copy this file to .env.local for local development
# or set these as secrets in your cloud provider.

# ─── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL connection string (Prisma)
# Copy the actual session-pooler URL from Supabase Connect for IPv4 deployments.
# Percent-encode the password. Direct db.<ref>.supabase.co normally needs IPv6.
DATABASE_URL="postgresql://postgres.PROJECT_REF:ENCODED_PASSWORD@SESSION_POOLER_HOST:5432/postgres?schema=public&sslmode=require"
MIGRATION_DATABASE_URL="" # optional direct/session-pooler URL; falls back to DATABASE_URL

# ─── Private Storage (Supabase; backend credentials only) ────────────────────
STORAGE_PROVIDER="supabase"
SUPABASE_URL="https://yodlirkepgdazryfxdae.supabase.co"
SUPABASE_SECRET_KEY="" # sb_secret_...; never prefix with VITE_ or expose in browser
# SUPABASE_SERVICE_ROLE_KEY="" # legacy alternative, only if required
IDENTITY_SNAPSHOT_BUCKET="identity-snapshots"
PROCTORING_EVIDENCE_BUCKET="proctoring-evidence"
DATA_WAREHOUSE_BUCKET="data-exports"
# Keep old S3 settings only while migrating legacy evidence:
# LEGACY_IDENTITY_SNAPSHOT_BUCKET=""
# LEGACY_PROCTORING_EVIDENCE_BUCKET=""
# AWS_REGION=""

# ─── AI / Gemini ──────────────────────────────────────────────────────────────
# Obtain from https://aistudio.google.com/apikey
GEMINI_API_KEY=""

# ─── Stripe Payments ─────────────────────────────────────────────────────────
# Obtain from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY="sk_live_..."
# Obtain from https://dashboard.stripe.com/webhooks (after creating the endpoint)
STRIPE_WEBHOOK_SECRET="whsec_..."

# ─── Application ──────────────────────────────────────────────────────────────
# The public-facing URL of this deployment (no trailing slash)
APP_URL="https://your-domain.com"

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (APP_URL is automatically included).
# Leave empty for API-only (no cross-origin browsers) deployments.
CORS_ORIGINS=""

# ─── Auth / JWT ──────────────────────────────────────────────────────────────
# Required in production — generate with: openssl rand -base64 48
# Server will refuse to start in production if these are missing or weak.
JWT_SECRET=""
REFRESH_SECRET=""

# ─── Observability ───────────────────────────────────────────────────────────
# Logger verbosity: trace | debug | info | warn | error | fatal
LOG_LEVEL="info"
# Sentry DSN (leave empty to disable). https://sentry.io > Project Settings > Client Keys
SENTRY_DSN=""
SENTRY_TRACES_SAMPLE_RATE="0.1"
SENTRY_PROFILES_SAMPLE_RATE="0.1"
# Release identifier (git SHA or semver) — helps Sentry group errors
SENTRY_RELEASE=""

# Optional: Firebase config for client-side auth (if Firebase auth is enabled)
# FIREBASE_API_KEY=""
# FIREBASE_AUTH_DOMAIN=""
# FIREBASE_PROJECT_ID=""
# FIREBASE_STORAGE_BUCKET=""
# FIREBASE_MESSAGING_SENDER_ID=""
# FIREBASE_APP_ID=""
